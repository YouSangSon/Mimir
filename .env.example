# Copy to .env (gitignored) and fill in — Mimir auto-loads it on every run.
# All keys are optional: a source whose key is absent is skipped and the skip is
# recorded in the run manifest. (In CI, real GitHub Actions Secrets take priority.)

# Stooq US prices: free apikey, issued via a one-time captcha at
# https://stooq.com/q/d/?s=aapl.us&get_apikey  (copy the apikey from the download link)
STOOQ_API_KEY=

# DART (Korean filings): free key from https://opendart.fss.or.kr
DART_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (no signup).
MIMIR_SEC_USER_AGENT=Your Name your-email@example.com

# Optional macro source (used from Increment 2 onward)
ECOS_API_KEY=

# Optional Telegram "collection done" ping
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM news-sentiment signal (OFF by default — paid). To enable: install
# the extra (pip install -e ".[llm]"), set llm_sentiment_enabled: true in
# config/sources.yaml, and provide this key. Without all three, no LLM call is made.
ANTHROPIC_API_KEY=
